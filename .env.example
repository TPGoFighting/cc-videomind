# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: openai-compatible | deepseek | gemini
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Transcript provider: mock | youtube
TRANSCRIPT_PROVIDER=youtube

# Admin（逗号分隔多个管理员邮箱）
ADMIN_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Domestic direct ASR (for Bilibili videos without subtitles, e.g. SiliconFlow)
ASR_API_BASE_URL="https://api.siliconflow.cn/v1"
ASR_API_KEY=
ASR_MODEL="FunAudioLLM/SenseVoiceSmall"

