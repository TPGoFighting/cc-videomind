# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authoritative production database (server only)
DATABASE_URL=postgresql://teachplayer_app:<password>@127.0.0.1:5432/teachplayer

# AI provider: openai-compatible | deepseek | gemini
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 回退模型列表（可选，逗号分隔）。仅当主模型调用失败时按顺序尝试，
# 模型名必须与你配置的 AI_API_BASE_URL 对应的平台一致（例如 OpenAI 兼容网关下的 gpt-4o、claude-3-5-sonnet 等）。
# 留空则不做任何回退，只使用 AI_MODEL。
AI_FALLBACK_MODELS=
# Transcript provider: youtube | supadata | remote
TRANSCRIPT_PROVIDER=youtube
SUPADATA_API_KEY=
# Optional HTTPS fallback hosted by the same authorized production stack.
TRANSCRIPT_FALLBACK_URL=

# Admin（逗号分隔多个管理员邮箱）
ADMIN_EMAIL=

# Internal workers (server only; use independent long random values)
ASYNC_TASK_WORKER_SECRET=
ACCOUNT_DELETION_WORKER_SECRET=

# Authorized-media ASR (only for files uploaded by their owner or license holder)
# A protected scheduler must POST {} to /api/worker at least once per minute.
ASR_API_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
