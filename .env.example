# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authoritative production database (server only)
DATABASE_URL=postgresql://teachplayer_app:<password>@127.0.0.1:5432/teachplayer

# AI provider: openai-compatible | deepseek | gemini
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 回退模型列表（可选，逗号分隔）。仅当主模型调用失败时按顺序尝试，
# 模型名必须与你配置的 AI_API_BASE_URL 对应的平台一致（例如 OpenAI 兼容网关下的 gpt-4o、claude-3-5-sonnet 等）。
# 留空则不做任何回退，只使用 AI_MODEL。
AI_FALLBACK_MODELS=
# Transcript provider: youtube | supadata | remote
TRANSCRIPT_PROVIDER=youtube
SUPADATA_API_KEY=
# Optional HTTPS fallback hosted by the same authorized production stack.
TRANSCRIPT_FALLBACK_URL=
# Optional proxy used by yt-dlp when the server cannot reach YouTube directly.
YTDLP_PROXY=
# Optional Netscape-format YouTube cookie file for the server's egress IP.
YTDLP_COOKIES_FILE=

# Admin（逗号分隔多个管理员邮箱）
ADMIN_EMAIL=

# Internal workers (server only; use independent long random values)
ASYNC_TASK_WORKER_SECRET=
ACCOUNT_DELETION_WORKER_SECRET=

# Authorized-media ASR (only for files uploaded by their owner or license holder)
# A protected scheduler must POST {} to /api/worker at least once per minute.
ASR_API_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# 人工转账审核收款码（可选；配置 HTTPS 图片 URL 后 /billing 显示人工通道）
MANUAL_PAYMENT_QR_IMAGE_URL=
MANUAL_PAYMENT_RECEIVER_HINT=

# 抖音支付 Native（扫码自动开通）
# 商家平台【产品中心 → 开发者配置 → 密钥管理】获取；私钥与加密密钥只放环境变量，严禁入库/进日志
DYPAY_APP_ID=
DYPAY_MCH_ID=
# 商户 API 证书序列号（如 41A48FEF2A9F04C5）
DYPAY_CERT_SERIAL=
# 商户接口加签私钥（PKCS#8 PEM，-----BEGIN PRIVATE KEY-----）
DYPAY_PRIVATE_KEY=
# 抖音支付平台公钥（SPKI PEM，-----BEGIN PUBLIC KEY-----，从平台证书导出；回调验签必须）
DYPAY_PLATFORM_PUBLIC_KEY=
# 接口加密密钥（32 字节字符串，回调解密必须）
DYPAY_ENCRYPT_KEY=
# 支付回调地址（必须是 https 且外网可达，不带查询参数）
DYPAY_NOTIFY_URL=https://teachplayer.tpgofighting.top/api/dypay/webhook
