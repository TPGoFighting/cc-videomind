{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "types": ["react", "react-native", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@teach-player/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "app",
    "src",
    "index.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
